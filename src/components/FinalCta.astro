---
import { spotsOpen } from '../data/site';
import { url } from '../lib/url';
---

<section class="wrap pb-24">
  <div class="relative overflow-hidden rounded-[36px] bg-spark px-6 py-20 text-center text-ink sm:py-28">
    <img class="absolute right-[-36px] top-[-30px] size-[110px] rotate-6 rounded-[20px] object-cover sm:size-[170px] md:right-[-60px] md:top-[-100px] md:size-[260px] md:rounded-[28px]" src={url('/media/v3.jpg')} alt="" loading="lazy" />
    <img class="absolute bottom-[-36px] left-[-30px] size-[100px] -rotate-6 rounded-[20px] object-cover sm:size-[150px] md:bottom-[-50px] md:left-[-40px] md:size-[220px] md:rounded-[28px]" src={url('/media/v2.jpg')} alt="" loading="lazy" />
    <div class="relative @container">
      <p class="font-mono text-[18px] uppercase tracking-[0.14em] text-ink/60 sm:text-[22px]">Audit. Document. Automate.</p>
      <!-- 1.5x the t-big scale; one line from sm up, sized to the card so it never overflows -->
      <h2 class="display mx-auto mt-6 text-[60px] sm:whitespace-nowrap sm:text-[min(144px,12.4cqw)]"><span class="block sm:inline">Consider it</span> <span class="accent block sm:inline">handled.</span></h2>
      <div class="mx-auto mt-10 flex max-w-sm flex-col items-center justify-center gap-3 sm:max-w-none sm:flex-row">
        <a href={url('/#book')} data-call class="btn-ink h-14 px-8 text-[16px] btn-wide">Book a free 30-min call</a>
        <a href={url('/#leak')} class="btn-line-ink h-14 px-8 text-[16px] btn-wide">Calculate your leak</a>
      </div>
      <p class="label mt-8 text-ink/60">{spotsOpen} build slot{spotsOpen === 1 ? '' : 's'} open this month · audit credited to your build</p>
    </div>
  </div>
</section>
