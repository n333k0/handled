---
import { url } from '../lib/url';
import ParentLogo from './ParentLogo.astro';
import Shader from './Shader.astro';
import { brand, spotsOpen, capacity } from '../data/site';

---

<section class="relative flex min-h-lvh items-center overflow-hidden pb-20 pt-[110px] sm:pt-[130px]">
  <Shader class="absolute inset-0" />
  <div class="wrap relative text-center">
    <a href={url('/#book')} class="chip mx-auto border-white/15 bg-white/5 text-paper/80 hover:border-spark/60">
      <span class="dot"></span>
      {spotsOpen} of {capacity.total} build slots open this month
    </a>

    <h1 class="display mx-auto mt-6 max-w-[15ch] t-hero">
      Your busywork. <span class="accent text-spark">Handled by AI.</span>
    </h1>

    <p class="mx-auto mt-5 max-w-[680px] text-[16px] leading-relaxed text-paper/75 sm:text-[17px]">
      Manual work quietly drains revenue you can’t see. We audit how your business runs, then install AI systems that do the work, inside the tools you already use.
    </p>

    <div class="mx-auto mt-10 flex max-w-sm flex-col items-center justify-center gap-3 sm:max-w-none sm:flex-row">
      <a href={url('/#book')} data-call class="btn-primary h-14 px-8 text-[16px] btn-wide">
        Book a free 30-min call
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4-4 4" stroke="currentColor" stroke-width="1.6" /></svg>
      </a>
      <a href={url('/#leak')} class="btn-ghost h-14 px-8 text-[16px] btn-wide">Calculate your leak</a>
    </div>

    <ul class="label mt-12 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-paper/50">
      <li>Audit first</li>
      <li aria-hidden="true">/</li>
      <li>Live in 3–4 weeks</li>
      <li aria-hidden="true">/</li>
      <li>Works with your stack</li>
      <li aria-hidden="true">/</li>
      <li>Model-agnostic</li>
    </ul>

    <a href={brand.parentUrl} class="mt-10 inline-flex items-center gap-2 text-white/90 transition hover:text-white" aria-label={`${brand.parentLine} ${brand.parent}`}>
      <span class="font-sans text-[14px] leading-none text-paper/55">{brand.parentLine}</span>
      <ParentLogo class="h-[14px]" />
    </a>
  </div>

</section>
