---
// Pains → process → the AI operating system → agents → stack → packages → deliverables.
import { url } from '../lib/url';
import Icon from './Icon.astro';
import ParentLogo from './ParentLogo.astro';
import { pains, steps, os, agents, stack, packages, deliverables, links, family } from '../data/site';
const agentTotal = os.reduce((n, o) => n + o.agents.length, 0);
// Connector curves: orchestrator (top centre) to the centre of each of the 4 columns.
const curves = os.map((_, i) => { const x = 50 + i * 100; return `M200 0 C200 46 ${x} 34 ${x} 80`; });
---

<!-- Pains -->
<section class="border-t border-white/10 bg-pine-950 py-24 sm:py-28">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="label text-spark">Sound familiar?</p>
      <h2 class="display mt-4 t-h2">You’ve outgrown how <span class="accent text-spark">your business runs.</span></h2>
    </div>
    <!-- scroll-linked: while the grid passes through the viewport, 01 → 04 light up in turn (page never pins) -->
    <div id="pains" class="scroll-light mt-12 grid gap-px overflow-hidden rounded-[24px] border border-white/10 bg-white/10 md:grid-cols-2" data-reveal>
      {pains.map((p, i) => (
        <div class="pain bg-pine-950 p-8 transition-colors duration-500">
          <p class="pain-n font-mono text-[13px] text-spark transition-colors duration-500">0{i + 1}</p>
          <h3 class="mt-6 text-[22px] font-medium tracking-tight">{p.title}</h3>
          <p class="pain-b mt-3 text-[15px] leading-relaxed text-paper/60 transition-colors duration-500">{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Process: accent block, dark type, flat cards -->
<section id="how" class="bg-spark py-24 text-ink sm:py-28">
  <div class="wrap">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
      <div>
        <p class="label text-ink/60">How it works</p>
        <h2 class="display mt-4 t-h2">Your operation, <span class="accent">rebuilt to run on AI.</span></h2>
      </div>
      <p class="max-w-sm text-[16px] text-ink/70">Three steps. We never build before we understand how your business actually works.</p>
    </div>
    <ol class="mt-12 grid gap-3 md:grid-cols-3" data-reveal>
      {steps.map((s) => (
        <li class="flex flex-col rounded-[24px] bg-ink/[0.07] p-8">
          <div class="flex items-center justify-between gap-4"><span class="font-mono text-[13px] text-ink/70">{s.n}</span><span class="label text-right text-ink/55">{s.time}</span></div>
          <h3 class="mt-8 text-[32px] font-medium tracking-tight">{s.title}</h3>
          <p class="mt-1 text-[16px] text-ink/80">{s.sub}</p>
          <p class="mt-4 text-[15px] leading-relaxed text-ink/70">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- The AI operating system -->
<section class="border-t border-white/10 bg-pine-950 py-24 sm:py-28">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="label text-spark">A few months from now</p>
      <h2 class="display mt-4 t-h2">One AI operating system. <span class="accent text-spark">Your people in control.</span></h2>
      <p class="mt-6 max-w-xl text-[17px] text-paper/60">Trained on how your business runs. Specialist agents handle sales, marketing, finance and operations in the background, and report to one place.</p>
    </div>
    <div id="os" class="mt-16" data-reveal>
      <!-- orchestrator -->
      <div class="flex justify-center">
        <div class="inline-flex items-center gap-4 rounded-[20px] bg-white/[0.06] py-4 pl-4 pr-6">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-white/[0.07] text-paper"><Icon name="cpu" class="size-[22px]" /></span>
          <span>
            <span class="block text-[18px] font-medium tracking-tight">Your AI chief of staff</span>
            <span class="mt-1 flex items-center gap-2 text-[13px] text-paper/55"><span class="dot size-1.5!"></span>Orchestrating {agentTotal} AI agents</span>
          </span>
        </div>
      </div>
      <!-- connectors (desktop): one curve to every area; the active one animates -->
      <svg class="hidden h-16 w-full lg:block" viewBox="0 0 400 80" preserveAspectRatio="none" aria-hidden="true">
        {curves.map((d, i) => (
          <g data-curve={i}>
            <path d={d} fill="none" stroke="rgb(255 255 255 / .14)" stroke-width="1" vector-effect="non-scaling-stroke" />
            <path class="flow" d={d} fill="none" stroke="var(--color-spark)" stroke-width="1.5" stroke-dasharray="4 5" vector-effect="non-scaling-stroke" />
          </g>
        ))}
      </svg>
      <div class="mx-auto h-8 w-px bg-white/15 lg:hidden"></div>
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-0">
        {os.map((o, i) => (
          <div class="os-col lg:px-1.5" data-col={i} data-on={i === 1 ? '' : undefined}>
            <div class="os-area flex items-center gap-4 rounded-[20px] bg-white/[0.06] p-4 transition-colors duration-500">
              <span class="os-tile grid size-11 shrink-0 place-items-center rounded-xl bg-white/[0.07] transition-colors duration-500"><Icon name={o.icon} class="size-[22px]" /></span>
              <span>
                <span class="block text-[18px] font-medium tracking-tight">{o.area}</span>
                <span class="block text-[13px] text-paper/50">{o.agents.length} AI agents</span>
              </span>
            </div>
            <div class="mx-auto h-5 w-px bg-white/15"></div>
            <ul class="space-y-2">
              {o.agents.map(([name, icon]) => (
                <li class="os-agent flex items-center gap-3 rounded-2xl bg-white/[0.035] p-2.5 pr-4 transition-colors duration-500">
                  <span class="os-tile grid size-9 shrink-0 place-items-center rounded-[10px] bg-white/[0.06] transition-colors duration-500"><Icon name={icon} class="size-[18px]" /></span>
                  <span class="min-w-0 flex-1 truncate text-[15px] text-paper/85">{name}</span>
                  <span class="os-dot size-1.5 shrink-0 rounded-full bg-white/20 transition-colors duration-500"></span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .pain.on { background: var(--color-spark); border-color: transparent; color: var(--color-ink); }
  .pain.on .pain-n { color: var(--color-ink); }
  .pain.on .pain-b { color: color-mix(in oklab, var(--color-ink) 75%, transparent); }

  /* Active area (cycles): accent-tinted cards, accent icons and live dots, animated connector. */
  .os-col[data-on] .os-area { background: color-mix(in oklab, var(--color-spark) 16%, transparent); }
  .os-col[data-on] .os-agent { background: color-mix(in oklab, var(--color-spark) 7%, transparent); }
  .os-col[data-on] .os-tile { color: var(--color-spark); background: color-mix(in oklab, var(--color-spark) 14%, transparent); }
  .os-col[data-on] .os-dot { background: var(--color-spark); }
  .flow { opacity: 0; transition: opacity .5s; animation: flow 1.2s linear infinite; }
  [data-curve].on .flow { opacity: 1; }
  @keyframes flow { to { stroke-dashoffset: -18; } }
  @media (prefers-reduced-motion: reduce) { .flow { animation: none; } }
</style>

<script>
  // Scroll-lit groups (pains, audit deliverables): progress of the group through the viewport picks which card is lit.
  document.querySelectorAll<HTMLElement>('.scroll-light').forEach((group) => {
    const cards = [...group.querySelectorAll<HTMLElement>('.pain')];
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = group.getBoundingClientRect(), vh = innerHeight;
      const p = (vh * 0.8 - r.top) / (r.height + vh * 0.5); // 0 when the top enters at 80% vh, 1 when the bottom leaves at 30% vh
      const on = p >= 0 && p < 1 ? Math.floor(p * cards.length) : -1;
      cards.forEach((c, i) => c.classList.toggle('on', i === on));
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
  });

  // Cycle the highlighted area while the tree is on screen.
  const root = document.getElementById('os');
  if (root) {
    const cols = [...root.querySelectorAll<HTMLElement>('.os-col')];
    const curves = [...root.querySelectorAll<SVGGElement>('[data-curve]')];
    let on = 1, timer = 0;
    const show = (n: number) => {
      cols.forEach((c, i) => c.toggleAttribute('data-on', i === n));
      curves.forEach((c, i) => c.classList.toggle('on', i === n));
    };
    show(on);
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      new IntersectionObserver(([e]) => {
        clearInterval(timer);
        if (e.isIntersecting) timer = window.setInterval(() => show((on = (on + 1) % cols.length)), 2600);
      }).observe(root);
    }
  }
</script>

<!-- Agents -->
<section class="py-24 sm:py-28">
  <div class="wrap">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
      <div>
        <p class="label text-spark">Agents</p>
        <h2 class="display mt-4 t-h2">A few of the agents <span class="accent text-spark">we build.</span></h2>
      </div>
      <p class="max-w-sm text-[16px] text-paper/60">Each one replaces hours of manual work a week. Yours are built the same way: around your workflows.</p>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {agents.map((a) => (
        <article class="rounded-[24px] border border-white/10 p-8 text-center" data-reveal>
          <span class="mx-auto grid size-14 place-items-center rounded-2xl bg-spark/12 text-spark"><Icon name={a.icon} class="size-6" /></span>
          <p class="label mt-6 text-paper/40">{a.area}</p>
          <h3 class="mt-2 text-[22px] font-medium tracking-tight">{a.name}</h3>
          <p class="mx-auto mt-2 max-w-[34ch] text-[15px] leading-relaxed text-paper/60">{a.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Stack -->
<section class="border-t border-white/10 py-24 sm:py-28">
  <div class="wrap text-center">
    <p class="label text-spark">Your stack</p>
    <h2 class="display mx-auto mt-4 max-w-[18ch] t-h2">We don’t replace your stack. <span class="accent text-spark">We automate it.</span></h2>
    <p class="mx-auto mt-6 max-w-xl text-[17px] text-paper/60">Your team keeps its logins and habits. It just stops doing the manual parts.</p>
    <ul class="mx-auto mt-10 flex max-w-5xl flex-wrap justify-center gap-2.5">
      {stack.map((s) => (
        <li class="flex items-center gap-3 rounded-full bg-white/[0.06] py-1.5 pl-1.5 pr-5 text-[15px] text-paper/85">
          <span class="grid size-9 place-items-center overflow-hidden rounded-full bg-white"><img src={url(`/stack/${s.logo}.png`)} alt="" width="22" height="22" class="size-[22px] object-contain" loading="lazy" /></span>
          {s.name}
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Packages -->
<section id="pricing" class="bg-paper py-24 text-ink sm:py-28">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="label text-pine-500">Pricing</p>
      <h2 class="display mt-4 t-h2">Start small. <span class="accent">Prove it. Scale it.</span></h2>
      <p class="mt-5 max-w-xl text-[17px] text-ink/60">Every engagement starts with an audit, credited in full to your build. No deck, no “next steps TBD”.</p>
    </div>
    <div class="mt-12 grid gap-px overflow-hidden rounded-[24px] border border-ink/10 bg-ink/10 lg:grid-cols-3">
      {packages.map((p) => (
        <article class:list={['flex flex-col p-8 sm:p-10', p.featured ? 'bg-pine-900 text-paper' : 'bg-white']}>
          <div class="flex items-center justify-between">
            <h3 class="text-[28px] font-medium tracking-tight">{p.name}</h3>
            {p.featured && <span class="chip border-0 bg-spark text-ink">Start here</span>}
          </div>
          <p class:list={['mt-2 text-[15px]', p.featured ? 'text-paper/60' : 'text-ink/55']}>{p.best}</p>
          <p class="mt-8"><span class="display text-[44px]">{p.price}</span> <span class:list={['text-[15px]', p.featured ? 'text-paper/50' : 'text-ink/45']}>{p.unit}</span></p>
          <ul class:list={['mt-8 space-y-3 border-t pt-8 text-[15px]', p.featured ? 'border-white/10' : 'border-ink/10']}>
            {p.points.map((pt) => <li class="flex gap-3"><span class="mt-[9px] size-1.5 shrink-0 rounded-full bg-spark"></span>{pt}</li>)}
          </ul>
          <a href={p.featured ? links.checkout : url('/#book')} data-call={p.featured ? undefined : ''} class="mt-auto pt-10">
            <span class:list={['w-full', p.featured ? 'btn-primary' : 'btn-ink']}>{p.cta}</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Deliverables -->
<section class="py-24 sm:py-28">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="label text-spark">The audit</p>
      <h2 class="display mt-4 t-h2">Your roadmap, <span class="accent text-spark">delivered in 48 hours.</span></h2>
      <p class="mt-5 max-w-xl text-[17px] text-paper/60">Three concrete assets, in writing, yours to keep forever.</p>
    </div>
    <div class="scroll-light mt-12 grid gap-5 md:grid-cols-3">
      {deliverables.map((d) => (
        <article class="pain rounded-[24px] border border-white/10 p-8 transition-colors duration-500" data-reveal>
          <p class="pain-n font-mono text-[13px] text-spark transition-colors duration-500">{d.n}</p>
          <h3 class="mt-6 text-[22px] font-medium tracking-tight">{d.title}</h3>
          <p class="pain-b mt-3 text-[15px] leading-relaxed text-paper/60 transition-colors duration-500">{d.body}</p>
        </article>
      ))}
    </div>

    <div class="mt-16 grid gap-px overflow-hidden rounded-[24px] border border-white/10 bg-white/10 md:grid-cols-2">
      {family.filter((f) => f.key !== 'handled').map((f) => (
        <a href={f.url} class="group flex items-center justify-between gap-6 bg-black p-8 transition-colors duration-300 hover:bg-(--brand) hover:text-ink" style={`--brand: ${f.color}`}>
          <span>
            <span class="flex items-center gap-2 text-paper/45 transition-colors group-hover:text-ink/60"><span class="label">From</span><ParentLogo class="h-[10px]" /></span>
            <span class="mt-3 block text-[24px] font-semibold tracking-tight">{f.name.replace('.', '')}<span class="text-(--brand) transition-colors group-hover:text-ink">.</span></span>
            <span class="mt-1 block text-[15px] text-paper/60 transition-colors group-hover:text-ink/70">{f.line}</span>
          </span>
          <span class="grid size-11 shrink-0 place-items-center rounded-full border border-white/20 transition group-hover:border-ink/25">→</span>
        </a>
      ))}
    </div>
  </div>
</section>
