---
// Pains → process → the AI operating system → agents → stack → packages → deliverables.
import { url } from '../lib/url';
import { pains, steps, os, agents, stack, packages, deliverables, links, family } from '../data/site';
---

<!-- Pains -->
<section class="border-t border-white/10 bg-pine-950 py-24 sm:py-28">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="label text-spark">Sound familiar?</p>
      <h2 class="display mt-4 t-h2">You’ve outgrown how <span class="accent text-spark">your business runs.</span></h2>
    </div>
    <div class="mt-12 grid gap-px overflow-hidden rounded-[24px] border border-white/10 bg-white/10 md:grid-cols-2" data-reveal>
      {pains.map((p, i) => (
        <div class="bg-pine-950 p-8">
          <p class="font-mono text-[13px] text-spark">0{i + 1}</p>
          <h3 class="mt-6 text-[22px] font-medium tracking-tight">{p.title}</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-paper/60">{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Process: accent block, dark type, flat cards -->
<section id="how" class="bg-spark py-24 text-ink sm:py-28">
  <div class="wrap">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
      <div>
        <p class="label text-ink/60">How it works</p>
        <h2 class="display mt-4 t-h2">Your operation, <span class="accent">rebuilt to run on AI.</span></h2>
      </div>
      <p class="max-w-sm text-[16px] text-ink/70">Three steps. We never build before we understand how your business actually works.</p>
    </div>
    <ol class="mt-12 grid gap-3 md:grid-cols-3" data-reveal>
      {steps.map((s) => (
        <li class="flex flex-col rounded-[24px] bg-ink/[0.07] p-8">
          <div class="flex items-center justify-between gap-4"><span class="font-mono text-[13px] text-ink/70">{s.n}</span><span class="label text-right text-ink/55">{s.time}</span></div>
          <h3 class="mt-8 text-[32px] font-medium tracking-tight">{s.title}</h3>
          <p class="mt-1 text-[16px] text-ink/80">{s.sub}</p>
          <p class="mt-4 text-[15px] leading-relaxed text-ink/70">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- The AI operating system -->
<section class="border-t border-white/10 bg-pine-950 py-24 sm:py-28">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="label text-spark">A few months from now</p>
      <h2 class="display mt-4 t-h2">One AI operating system. <span class="accent text-spark">Your people in control.</span></h2>
      <p class="mt-6 max-w-xl text-[17px] text-paper/60">Trained on how your business runs. Specialist agents handle sales, marketing, finance and operations in the background, and report to one place.</p>
    </div>
    <div class="mt-12 rounded-[24px] border border-white/10 p-4 sm:p-6" data-reveal>
      <div class="mx-auto max-w-md rounded-[24px] bg-spark p-5 text-center text-ink">
        <p class="label text-ink/60">Orchestrator</p>
        <p class="mt-1 text-[22px] font-semibold tracking-tight">Your AI chief of staff</p>
      </div>
      <div class="mx-auto h-8 w-px bg-white/20"></div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {os.map((o) => (
          <div class="rounded-[24px] bg-pine-800 p-5">
            <p class="label text-spark">{o.area}</p>
            <ul class="mt-4 space-y-2 text-[14px]">
              {o.agents.map((a) => <li class="flex items-center gap-2 text-paper/80"><span class="dot"></span>{a}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Agents -->
<section class="py-24 sm:py-28">
  <div class="wrap">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
      <div>
        <p class="label text-spark">Agents</p>
        <h2 class="display mt-4 t-h2">A few of the agents <span class="accent text-spark">we build.</span></h2>
      </div>
      <p class="max-w-sm text-[16px] text-paper/60">Each one replaces hours of manual work a week. Yours are built the same way: around your workflows.</p>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {agents.map((a) => (
        <article class="rounded-[24px] border border-white/10 p-7" data-reveal>
          <div class="flex items-center justify-between">
            <span class="grid size-10 place-items-center rounded-full bg-spark/15 text-spark">✦</span>
            <span class="label text-paper/40">{a.area}</span>
          </div>
          <h3 class="mt-6 text-[22px] font-medium tracking-tight">{a.name}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-paper/60">{a.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Stack -->
<section class="border-t border-white/10 py-24 sm:py-28">
  <div class="wrap text-center">
    <p class="label text-spark">Your stack</p>
    <h2 class="display mx-auto mt-4 max-w-[18ch] t-h2">We don’t replace your stack. <span class="accent text-spark">We automate it.</span></h2>
    <p class="mx-auto mt-6 max-w-xl text-[17px] text-paper/60">Your team keeps its logins and habits. It just stops doing the manual parts.</p>
    <ul class="mx-auto mt-10 flex max-w-4xl flex-wrap justify-center gap-2">
      {stack.map((s) => <li class="rounded-full border border-white/10 px-4 py-2 text-[14px] text-paper/80">{s}</li>)}
    </ul>
  </div>
</section>

<!-- Packages -->
<section id="pricing" class="bg-paper py-24 text-ink sm:py-28">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="label text-pine-500">Pricing</p>
      <h2 class="display mt-4 t-h2">Start small. <span class="accent">Prove it. Scale it.</span></h2>
      <p class="mt-5 max-w-xl text-[17px] text-ink/60">Every engagement starts with an audit, credited in full to your build. No deck, no “next steps TBD”.</p>
    </div>
    <div class="mt-12 grid gap-px overflow-hidden rounded-[24px] border border-ink/10 bg-ink/10 lg:grid-cols-3">
      {packages.map((p) => (
        <article class:list={['flex flex-col p-8 sm:p-10', p.featured ? 'bg-pine-900 text-paper' : 'bg-white']}>
          <div class="flex items-center justify-between">
            <h3 class="text-[28px] font-medium tracking-tight">{p.name}</h3>
            {p.featured && <span class="chip border-0 bg-spark text-ink">Start here</span>}
          </div>
          <p class:list={['mt-2 text-[15px]', p.featured ? 'text-paper/60' : 'text-ink/55']}>{p.best}</p>
          <p class="mt-8"><span class="display text-[44px]">{p.price}</span> <span class:list={['text-[15px]', p.featured ? 'text-paper/50' : 'text-ink/45']}>{p.unit}</span></p>
          <ul class:list={['mt-8 space-y-3 border-t pt-8 text-[15px]', p.featured ? 'border-white/10' : 'border-ink/10']}>
            {p.points.map((pt) => <li class="flex gap-3"><span class="mt-[9px] size-1.5 shrink-0 rounded-full bg-spark"></span>{pt}</li>)}
          </ul>
          <a href={p.featured ? links.checkout : url('/#book')} data-call={p.featured ? undefined : ''} class="mt-auto pt-10">
            <span class:list={['w-full', p.featured ? 'btn-primary' : 'btn-ink']}>{p.cta}</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Deliverables -->
<section class="py-24 sm:py-28">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <p class="label text-spark">The audit</p>
      <h2 class="display mt-4 t-h2">Your roadmap, <span class="accent text-spark">delivered in 48 hours.</span></h2>
      <p class="mt-5 max-w-xl text-[17px] text-paper/60">Three concrete assets, in writing, yours to keep forever.</p>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {deliverables.map((d) => (
        <article class="rounded-[24px] border border-white/10 p-8" data-reveal>
          <p class="font-mono text-[13px] text-spark">{d.n}</p>
          <h3 class="mt-6 text-[22px] font-medium tracking-tight">{d.title}</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-paper/60">{d.body}</p>
        </article>
      ))}
    </div>

    <div class="mt-16 grid gap-px overflow-hidden rounded-[24px] border border-white/10 bg-white/10 md:grid-cols-2">
      {family.filter((f) => f.key !== 'handled').map((f) => (
        <a href={f.url} class="group flex items-center justify-between gap-6 bg-pine-900 p-8">
          <span><span class="label text-paper/40">From RemotoLabs</span><span class="mt-2 block text-[24px] font-semibold tracking-tight">{f.name}</span><span class="mt-1 block text-[15px] text-paper/60">{f.line}</span></span>
          <span class="grid size-11 shrink-0 place-items-center rounded-full border border-white/20 transition group-hover:border-spark group-hover:text-spark">→</span>
        </a>
      ))}
    </div>
  </div>
</section>
