---
// Neon hero background: Paper Shaders "Neuro Noise" (Apache-2.0, @paper-design/shaders),
// tinted to handled's blue. The web drifts slightly toward the cursor.
// Pauses off-screen (built into ShaderMount), stays still for reduced motion.
const { class: className = '' } = Astro.props;
---

<div class:list={['shader pointer-events-none', className]} aria-hidden="true">
  <div class="mount absolute inset-0"></div>
  <div class="veil absolute inset-0"></div>
</div>

<style>
  .shader { background: radial-gradient(60% 50% at 50% 30%, rgb(91 60 255 / .25), transparent 70%); }
  .shader .mount { mask-image: linear-gradient(to bottom, #000 50%, transparent); -webkit-mask-image: linear-gradient(to bottom, #000 50%, transparent); }
  /* keep the copy readable: darker in the middle where the headline sits */
  .shader .veil { background: radial-gradient(42% 38% at 50% 42%, rgb(0 0 0 / .72), transparent 100%); }
</style>

<script>
  import { ShaderMount, neuroNoiseFragmentShader, getShaderColorFromString, ShaderFitOptions } from '@paper-design/shaders';

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const box of document.querySelectorAll<HTMLElement>('.shader')) {
    const el = box.querySelector<HTMLElement>('.mount')!;
    let mount: ShaderMount;
    try {
      mount = new ShaderMount(el, neuroNoiseFragmentShader, {
        u_colorFront: getShaderColorFromString('#c8d2ff'),
        u_colorMid: getShaderColorFromString('#5b3cff'),
        u_colorBack: getShaderColorFromString('#00000000'),
        u_brightness: 0.06,
        u_contrast: 0.35,
        u_fit: ShaderFitOptions.none,
        u_scale: 0.9,
        u_rotation: 0,
        u_offsetX: 0,
        u_offsetY: 0,
        u_originX: 0.5,
        u_originY: 0.5,
        u_worldWidth: 0,
        u_worldHeight: 0,
      }, undefined, still ? 0 : 0.6, 40, 1, 1920 * 1080);
    } catch { continue; }
    if (still) continue;

    // Ease the pattern toward the pointer.
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
    const tick = () => {
      x += (tx - x) * 0.05; y += (ty - y) * 0.05;
      mount.setUniforms({ u_offsetX: x, u_offsetY: y });
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.0005 ? requestAnimationFrame(tick) : 0;
    };
    addEventListener('pointermove', (e) => {
      tx = (e.clientX / innerWidth - 0.5) * -0.12;
      ty = (e.clientY / innerHeight - 0.5) * 0.12;
      if (!raf) raf = requestAnimationFrame(tick);
    }, { passive: true });
  }
</script>
