---
// Animated light-beam shader for the hero background (in the spirit of shaders.com).
// Plain WebGL, no dependencies. Renders at half resolution (it's soft anyway),
// pauses off-screen, draws one still frame for reduced motion, falls back to a CSS glow.
const { class: className = '' } = Astro.props;
---

<div class:list={['shader pointer-events-none', className]} aria-hidden="true">
  <canvas class="size-full"></canvas>
</div>

<style>
  .shader { background: radial-gradient(60% 50% at 60% 30%, rgb(91 60 255 / .35), transparent 70%); }
  .shader.gl { background: none; }
  .shader canvas { mask-image: linear-gradient(to bottom, #000 55%, transparent); -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent); }
</style>

<script>
  const frag = `
    precision highp float;
    uniform vec2 r; uniform float t;
    float h(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
    float n(vec2 p){ vec2 i = floor(p), f = fract(p); f = f*f*(3.-2.*f);
      return mix(mix(h(i), h(i+vec2(1,0)), f.x), mix(h(i+vec2(0,1)), h(i+vec2(1,1)), f.x), f.y); }
    float fbm(vec2 p){ float v = 0., a = .5; for (int k = 0; k < 5; k++) { v += a*n(p); p *= 2.02; a *= .5; } return v; }
    float beam(vec2 p, float off, float w, float s){
      float d = p.y - off + .35*(fbm(p*1.3 + vec2(t*.05*s, -t*.03)) - .5);
      return exp(-d*d / w);
    }
    void main(){
      vec2 uv = gl_FragCoord.xy / r;
      vec2 p = (gl_FragCoord.xy - .5*r) / r.y;
      float a = -.62; p = mat2(cos(a), -sin(a), sin(a), cos(a)) * p;   // diagonal beams
      float b1 = beam(p, .22 + .05*sin(t*.11), .012, 1.);
      float b2 = beam(p, .02 + .06*sin(t*.07 + 1.7), .030, -.8);
      float b3 = beam(p, .42 + .04*cos(t*.09), .010, .6);
      vec3 blue = vec3(.17, .12, 1.0), violet = vec3(.50, .16, .92), accent = vec3(.48, .58, 1.0);
      vec3 col = blue*b2*.6 + violet*b1*.7 + accent*b3*.4;
      col += violet * .06 * fbm(p*2. + t*.02);                          // haze
      col *= smoothstep(1.15, .25, length(uv - vec2(.62, .78)));         // keep it up and to the right
      col *= mix(.35, 1., smoothstep(.05, .6, length((uv - vec2(.5, .6)) * vec2(1.1, 1.9)))); // calmer behind the copy
      col += (h(gl_FragCoord.xy + t) - .5) / 128.;                       // grain, no banding
      col = clamp(col, 0., 1.);
      gl_FragColor = vec4(col, max(col.r, max(col.g, col.b)));
    }`;

  for (const box of document.querySelectorAll<HTMLElement>('.shader')) {
    const canvas = box.querySelector('canvas')!;
    const gl = canvas.getContext('webgl', { antialias: false, premultipliedAlpha: true });
    if (!gl) continue;
    const sh = (type: number, src: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s); return s; };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, 'attribute vec2 p;void main(){gl_Position=vec4(p,0,1);}'));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, frag));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) continue;
    gl.useProgram(prog);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
    const uR = gl.getUniformLocation(prog, 'r'), uT = gl.getUniformLocation(prog, 't');
    box.classList.add('gl');

    const resize = () => {
      const s = Math.min(devicePixelRatio, 2) * 0.5;
      canvas.width = Math.max(1, Math.round(box.clientWidth * s));
      canvas.height = Math.max(1, Math.round(box.clientHeight * s));
      gl.viewport(0, 0, canvas.width, canvas.height);
    };
    const draw = (ms: number) => { gl.uniform2f(uR, canvas.width, canvas.height); gl.uniform1f(uT, 20 + ms / 1000); gl.drawArrays(gl.TRIANGLES, 0, 3); };
    new ResizeObserver(() => { resize(); draw(performance.now()); }).observe(box);
    resize();

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { draw(0); continue; }
    let on = true, raf = 0;
    const loop = (ms: number) => { draw(ms); if (on) raf = requestAnimationFrame(loop); };
    new IntersectionObserver(([e]) => { on = e.isIntersecting; cancelAnimationFrame(raf); if (on) raf = requestAnimationFrame(loop); }).observe(box);
  }
</script>
