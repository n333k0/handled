---
// Neon hero background: Paper Shaders "Neuro Noise" (Apache-2.0, @paper-design/shaders),
// tinted to handled's blue. The web drifts slightly toward the cursor.
// Pauses off-screen (built into ShaderMount), stays still for reduced motion.
const { class: className = '' } = Astro.props;
---

<div class:list={['shader pointer-events-none', className]} aria-hidden="true">
  <!-- screen blend keeps the canvas on the normal compositing path, so its darks always match the page (no dark block that vanishes on scroll) -->
  <div class="mount absolute inset-0 mix-blend-screen"></div>
</div>

<style>
  /* Frames the copy instead of sitting behind it: the centre is masked out, edges glow,
     and it fades out at the bottom of the hero. */
  .shader .mount {
    opacity: 1;
    -webkit-mask-image: radial-gradient(ellipse 52% 46% at 50% 50%, transparent 58%, #000 100%), linear-gradient(to bottom, #000 70%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: radial-gradient(ellipse 52% 46% at 50% 50%, transparent 58%, #000 100%), linear-gradient(to bottom, #000 70%, transparent);
    mask-composite: intersect;
  }
</style>

<script>
  import { ShaderMount, neuroNoiseFragmentShader, getShaderColorFromString, ShaderFitOptions } from '@paper-design/shaders';

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const box of document.querySelectorAll<HTMLElement>('.shader')) {
    const el = box.querySelector<HTMLElement>('.mount')!;
    let mount: ShaderMount;
    try {
      mount = new ShaderMount(el, neuroNoiseFragmentShader, {
        u_colorFront: getShaderColorFromString('#a9b5ff'),
        u_colorMid: getShaderColorFromString('#4b34e6'),
        u_colorBack: getShaderColorFromString('#0b0b0b00'), // transparent: the page's own off-black shows through, so no tone jump on scroll
        u_brightness: 0.16,
        u_contrast: 0.75,
        u_fit: ShaderFitOptions.none,
        u_scale: 1.8,
        u_rotation: 0,
        u_offsetX: 0,
        u_offsetY: 0,
        u_originX: 0.5,
        u_originY: 0.5,
        u_worldWidth: 0,
        u_worldHeight: 0,
      }, undefined, still ? 0 : 0.4, 40, 1, 1920 * 1080);
    } catch { continue; }
    if (still) continue;

    // Ease the pattern toward the pointer.
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
    const tick = () => {
      x += (tx - x) * 0.05; y += (ty - y) * 0.05;
      mount.setUniforms({ u_offsetX: x, u_offsetY: y });
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.0005 ? requestAnimationFrame(tick) : 0;
    };
    addEventListener('pointermove', (e) => {
      tx = (e.clientX / innerWidth - 0.5) * -0.12;
      ty = (e.clientY / innerHeight - 0.5) * 0.12;
      if (!raf) raf = requestAnimationFrame(tick);
    }, { passive: true });
  }
</script>
